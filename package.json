{
  "name": "gym-tracker",
  "private": true,
  "type": "module",
  "description": "Offline-first gym tracker with friends and gym dates. The app itself has no build step; npm is only for tests and lint.",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.js",
    "test:e2e": "playwright test --project=web",
    "test:android": "bash tools/android-e2e.sh",
    "test:all": "npm run lint && npm test && npm run test:db && npm run test:e2e",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "schema": "node tools/build-schema.mjs",
    "vendor": "node tools/vendor.mjs",
    "sw-hash": "node tools/sw-hash.mjs",
    "test:ios": "bash tools/ios-e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supabase": "2.122.0",
    "vitest": "^5.0.5"
  }
}
